# Protomaps API Key (Get one at protomaps.com)
VITE_PROTOMAPS_API_KEY=

# API URL for boundary and bubble data.
# - Local Dev: Leave blank (uses Vite mock on /api/data)
# - Staging: Set this to your Supabase Storage URL or Python backend
#   e.g., https://[PROJECT_ID].supabase.co/storage/v1/object/public/data
VITE_API_URL=

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Toggle local mock API (leave 'true' for dev, 'false' for staging/prod)
VITE_USE_MOCK_API=true

# Developer Controls (Set to 'true' in staging/dev, 'false' in production)
VITE_BYPASS_ENABLED=false

# Where to redirect users after clicking auth email links
VITE_REDIRECT_URL=http://localhost:5173/bubbles-frontend/
