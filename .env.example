# Protomaps API Key (Get one at protomaps.com)
VITE_PROTOMAPS_API_KEY=

# API URL for boundary and bubble data.
# If left blank:
# - Dev/Preview: Defaults to local vite plugin (/api/data)
# - Deployed/Build: Defaults to public data folder (/bubbles-frontend/data)
VITE_API_URL=

# Toggle the mock API plugin (default: true)
VITE_USE_MOCK_API=true
